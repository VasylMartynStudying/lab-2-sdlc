flowchart TD
  A([Метод Якобі]) --> B[/A, b, n, ε, kmax/]
  B --> C{Усі aᵢᵢ ≠ 0?}
  C -- ні --> D[/Метод незастосовний/]
  D --> Z([Кінець])
  C -- так --> E[x = 0; k = 0]
  E --> F["yᵢ = (bᵢ − Σⱼ≠ᵢ aᵢⱼ xⱼ) / aᵢᵢ<br>для всіх i (лише старе x)"]
  F --> G["k = k + 1; Δ = max модуль (yᵢ − xᵢ)<br>x = y"]
  G --> H{"max модуль xᵢ ≤ 10¹⁰⁰?"}
  H -- ні --> I[статус: розбігся]
  H -- так --> J{Δ ≤ ε?}
  J -- так --> K[статус: збігся]
  J -- ні --> L{k < kmax?}
  L -- так --> F
  L -- ні --> M[статус: ліміт вичерпано]
  I --> N[/x, k, статус/]
  K --> N
  M --> N
  N --> Z
