flowchart TD
  A([Перевірка переваги]) --> B[/Матриця A, n/]
  B --> C[q = 0; порушення = порожньо<br>i = 1]
  C --> D{i ≤ n?}
  D -- так --> E[s = сума модулів aᵢⱼ, j ≠ i]
  E --> F{модуль aᵢᵢ > s?}
  F -- ні --> G[Додати i<br>до порушень]
  F -- так --> H
  G --> H{aᵢᵢ = 0?}
  H -- так --> I[q = ∞]
  H -- ні --> J["q = max(q, s / модуль aᵢᵢ)"]
  I --> K[i = i + 1]
  J --> K
  K --> D
  D -- ні --> L[/strict = порушень немає;<br>список рядків; q/]
  L --> M([Кінець])
