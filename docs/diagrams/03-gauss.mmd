flowchart TD
  A([Метод Гаусса]) --> B[/A, b, n/]
  B --> C["W = [A | b]; τ = n · εм · max модулів A<br>k = 1"]
  C --> D{k ≤ n?}
  D -- так --> E["p = рядок з max модулем W[i][k], i ≥ k"]
  E --> F{"модуль W[p][k] ≤ τ?"}
  F -- так --> G[/Матриця вироджена/]
  G --> Z([Кінець])
  F -- ні --> H{p ≠ k?}
  H -- так --> I[Переставити рядки k і p]
  H -- ні --> J
  I --> J["Для кожного i > k:<br>m = W[i][k] / W[k][k]<br>рядок i = рядок i − m · рядок k"]
  J --> K[k = k + 1]
  K --> D
  D -- ні --> L[i = n]
  L --> M{i ≥ 1?}
  M -- так --> N["xᵢ = (Wᵢ,ₙ₊₁ − Σⱼ>ᵢ Wᵢⱼ xⱼ) / Wᵢᵢ"]
  N --> O[i = i − 1]
  O --> M
  M -- ні --> P[/Вектор x/]
  P --> Z
